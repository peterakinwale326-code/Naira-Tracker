datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                String             @id @default(uuid())
  email             String             @unique
  passwordHash      String
  name              String
  role              String             @default("USER")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  savedCalculations SavedCalculation[]
}

model SavedCalculation {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title            String
  amount           Float
  baseYear         Int
  targetYear       Int
  equivalentAmount Float
  lossPercent      Float
  createdAt        DateTime @default(now())

  @@index([userId])
}

model InflationData {
  id           String   @id @default(uuid())
  year         Int
  month        Int
  headlineRate Float
  foodRate     Float
  coreRate     Float
  cpiIndex     Float
  momRate      Float?
  sourceUrl    String?
  publishedAt  DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([year, month], name: "unique_year_month")
  @@index([year, month])
}

model CommodityPrice {
  id          String   @id @default(uuid())
  itemName    String
  category    String
  price       Float
  unit        String
  marketState String   @default("Lagos")
  recordDate  DateTime
  sourceUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([itemName, recordDate])
  @@index([category])
}
