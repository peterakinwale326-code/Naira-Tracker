{
  "name": "naira-inflation-backend",
  "version": "1.0.0",
  "description": "NestJS backend for Naira Inflation Tracker and Purchasing Power Calculator",
  "scripts": {
    "build": "tsc",
    "start": "ts-node src/main.ts",
    "start:dev": "ts-node src/main.ts",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "vercel-build": "prisma generate --schema prisma/schema.production.prisma && prisma db push --schema prisma/schema.production.prisma && npm run build",
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.3.7",
    "@nestjs/core": "^10.3.7",
    "@nestjs/platform-express": "^10.3.7",
    "@nestjs/schedule": "^4.0.1",
    "@prisma/client": "^5.12.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.10",
    "jsonwebtoken": "^9.0.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.12.7",
    "@vercel/node": "^30.0.0",
    "prisma": "^5.12.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
