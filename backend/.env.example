PORT=4000
# Local development uses SQLite. Vercel production uses the linked Neon Postgres database.
DATABASE_URL="file:./dev.db"
# Production-only, supplied by the Neon integration:
# DATABASE_URL_UNPOOLED="postgresql://..."
JWT_SECRET="replace-with-a-long-random-secret"
ADMIN_EMAIL="admin@nairatracker.ng"
ADMIN_PASSWORD="replace-with-a-strong-password"
# Set true only for a one-time production admin password reset, then unset it.
ADMIN_PASSWORD_RESET=false

# Add keys on the backend only; never use NEXT_PUBLIC_ variables or commit real keys.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
# Primary model, then tried in order when the previous model/key combinations fail.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.8-flash

# Optional, keyless web-search fallback for missing facts and current information.
# Set this to the origin of a SearXNG instance; backend requests /search?format=json.
WEB_SEARCH_URL=
